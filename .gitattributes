# Normalize line endings so Windows/macOS collaborators don't produce
# whole-file diffs. Repo stores LF; working copies get LF.
* text=auto eol=lf

# Binary assets — never touch these
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary

# Generated; collapse in diffs and reviews
package-lock.json -diff linguist-generated
